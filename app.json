{
  "expo": {
    "name": "Paws&Love",
    "slug": "Kototeka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "kototeka",
    "ios": {
      "userInterfaceStyle": "automatic",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Приложение сохраняет изображения в фотопленку",
        "NSPhotoLibraryUsageDescription": "Приложение получает доступ к фотопленке для сохранения изображений"
      },
      "bundleIdentifier": "com.anonymous.Kototeka"
    },
    "android": {
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "INTERNET",
        "READ_MEDIA_IMAGES"
      ],
      "package": "com.anonymous.Kototeka",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-system-ui",
        {
          "userInterfaceStyle": "automatic"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f9fafc",
          "image": null
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Разрешить доступ к фото",
          "savePhotosPermission": "Разрешить сохранение фото",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/Images/notification.png",
          "color": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "433f97d5-331e-4cf8-956c-72a6022f9efb"
      }
    },
    "owner": "animasola"
  }
}
